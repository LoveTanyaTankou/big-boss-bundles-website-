<script>

/* =========================================================
   BIG BOSS BUNDLES
   SHOP BY TEXTURE
========================================================= */


/* Allowed textures */

const allowedTextures = [
  "Straight",
  "Kinky Straight",
  "Body Wave",
  "Deep Wave",
  "Curly",
  "Kinky Curly"
];


/* Read texture from URL */

const params =
  new URLSearchParams(window.location.search);

let texture =
  params.get("texture") || "Body Wave";


/* Validate texture */

const matchedTexture =
  allowedTextures.find(
    item =>
      item.toLowerCase() ===
      texture.toLowerCase()
  );

texture =
  matchedTexture || "Body Wave";


/* URL-safe version */

const encodedTexture =
  encodeURIComponent(texture);


/* =========================
   UPDATE PAGE TITLE
========================= */

document.title =
  `Shop ${texture} Hair | Big Boss Bundles`;


document.getElementById(
  "textureTitle"
).textContent =
  `Shop ${texture}`;


document.getElementById(
  "textureDescription"
).textContent =
  `Explore ${texture} across Big Boss Bundles luxury hair collections. Shop bundles, wigs, HD lace closures and frontals in your selected texture.`;


document.getElementById(
  "selectedTexture"
).textContent =
  `Selected Texture: ${texture}`;


document.getElementById(
  "shopHeading"
).textContent =
  `${texture} Collection`;


/* =========================
   UPDATE CATEGORY TEXT
========================= */

document.getElementById(
  "bundlesDescription"
).textContent =
  `Shop ${texture} luxury bundles in multiple origins, lengths and color options.`;


document.getElementById(
  "wigsDescription"
).textContent =
  `Shop ${texture} luxury HD lace wigs with multiple origins, lengths, densities, lace sizes and colors.`;


document.getElementById(
  "closuresDescription"
).textContent =
  `Shop ${texture} HD lace closures for seamless, natural-looking installs.`;


document.getElementById(
  "frontalsDescription"
).textContent =
  `Shop ${texture} HD lace frontals for versatile, seamless installs and beautiful styling.`;


/* =========================
   UPDATE BUTTON TEXT
========================= */

document.getElementById(
  "bundlesButton"
).textContent =
  `Shop ${texture} Bundles →`;


document.getElementById(
  "wigsButton"
).textContent =
  `Shop ${texture} Wigs →`;


document.getElementById(
  "closuresButton"
).textContent =
  `Shop ${texture} Closures →`;


document.getElementById(
  "frontalsButton"
).textContent =
  `Shop ${texture} Frontals →`;


/* =========================
   UPDATE LINKS
========================= */

document.getElementById(
  "bundlesLink"
).href =
  `bundles.html?texture=${encodedTexture}`;


document.getElementById(
  "wigsLink"
).href =
  `wigs.html?texture=${encodedTexture}`;


document.getElementById(
  "closuresLink"
).href =
  `closures.html?texture=${encodedTexture}#closures`;


document.getElementById(
  "frontalsLink"
).href =
  `closures.html?texture=${encodedTexture}#frontals`;


/* =========================
   HIGHLIGHT CURRENT TEXTURE
========================= */

document
  .querySelectorAll(".texture-choice")
  .forEach(button => {

    if (
      button.dataset.texture === texture
    ) {

      button.classList.add("active");

    }

  });

</script>


