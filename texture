  }

  .texture-category-card {
    min-height:330px;
    padding:28px 24px;
  }

  .texture-buttons {
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .footer-grid {
    grid-template-columns:1fr;
  }

}

</style>

