<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Shop By Texture | Big Boss Bundles</title>

<meta
  name="description"
  content="Shop Big Boss Bundles luxury raw hair by texture. Explore bundles, wigs, HD lace closures and frontals in Straight, Kinky Straight, Body Wave, Deep Wave, Curly and Kinky Curly."
>

<style>

:root {
  --black:#0a0a0a;
  --soft-black:#141414;
  --gold:#d4a622;
  --teal:#00a6d6;
  --white:#ffffff;
  --cream:#f8f7f3;
  --gray:#777777;
}

* {
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html {
  scroll-behavior:smooth;
}

body {
  font-family:Arial, Helvetica, sans-serif;
  background:var(--white);
  color:var(--black);
  line-height:1.5;
}

a {
  color:inherit;
  text-decoration:none;
}

/* =========================
   ANNOUNCEMENT
========================= */

.announcement {
  background:var(--teal);
  color:var(--white);
  text-align:center;
  padding:10px 18px;
  font-size:.76rem;
  font-weight:800;
  letter-spacing:.11em;
  text-transform:uppercase;
}

/* =========================
   HEADER
========================= */

.site-header {
  position:sticky;
  top:0;
  z-index:999;
  background:rgba(10,10,10,.97);
  border-bottom:2px solid var(--gold);
}

.header-inner {
  width:min(1380px,94%);
  margin:auto;
  min-height:88px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:30px;
}

.logo {
  width:190px;
  flex-shrink:0;
}

.logo img {
  display:block;
  width:100%;
  max-height:74px;
  object-fit:contain;
}

.nav {
  display:flex;
  align-items:center;
  justify-content:flex-end;
  flex-wrap:wrap;
  gap:20px;
}

.nav a {
  color:var(--white);
  font-size:.78rem;
  font-weight:800;
  letter-spacing:.06em;
  text-transform:uppercase;
}

.nav a:hover {
  color:var(--teal);
}

/* =========================
   HERO
========================= */

.texture-hero {
  padding:90px 5% 80px;
  background:
    radial-gradient(
      circle at top right,
      rgba(0,166,214,.22),
      transparent 42%
    ),
    var(--black);

  color:var(--white);
  text-align:center;
}

.eyebrow {
  display:block;
  color:var(--teal);
  font-size:.76rem;
  font-weight:900;
  letter-spacing:.20em;
  text-transform:uppercase;
}

.texture-hero h1 {
  max-width:1100px;
  margin:12px auto 0;

  color:var(--gold);

  font-family:Georgia, "Times New Roman", serif;
  font-size:clamp(3rem,7vw,6rem);
  line-height:.98;

  text-transform:uppercase;
}

.texture-hero p {
  max-width:760px;
  margin:22px auto 0;

  color:rgba(255,255,255,.78);
  font-size:1.05rem;
}

.selected-texture {
  display:inline-block;

  margin-top:28px;
  padding:11px 22px;

  border:2px solid var(--teal);
  border-radius:999px;

  color:var(--white);

  font-size:.78rem;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
}

/* =========================
   SHOP SECTION
========================= */

.shop-section {
  padding:80px 5% 95px;
  background:var(--cream);
}

.heading {
  width:min(850px,100%);
  margin:0 auto 45px;
  text-align:center;
}

.heading h2 {
  margin-top:8px;

  color:var(--gold);

  font-family:Georgia, "Times New Roman", serif;
  font-size:clamp(2.2rem,5vw,4.2rem);
  line-height:1;

  text-transform:uppercase;
}

.heading p {
  max-width:720px;
  margin:17px auto 0;

  color:var(--gray);
}

/* =========================
   PRODUCT CATEGORY CARDS
========================= */

.texture-category-grid {
  width:min(1180px,100%);
  margin:auto;

  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));

  gap:25px;
}

.texture-category-card {
  min-height:360px;

  padding:36px;

  border:2px solid var(--gold);
  border-radius:24px;

  background:
    radial-gradient(
      circle at top right,
      rgba(0,166,214,.19),
      transparent 43%
    ),
    var(--black);

  color:var(--white);

  display:flex;
  flex-direction:column;
  justify-content:space-between;

  box-shadow:0 14px 38px rgba(0,0,0,.13);

  transition:
    transform .2s ease,
    border-color .2s ease;
}

.texture-category-card:hover {
  transform:translateY(-5px);
  border-color:var(--teal);
}

.category-number {
  color:var(--teal);

  font-size:.75rem;
  font-weight:900;
  letter-spacing:.18em;

  text-transform:uppercase;
}

.texture-category-card h3 {
  margin-top:14px;

  color:var(--gold);

  font-family:Georgia, "Times New Roman", serif;
  font-size:clamp(2rem,4vw,3.2rem);
  line-height:1;

  text-transform:uppercase;
}

.texture-category-card p {
  margin-top:18px;

  max-width:470px;

  color:rgba(255,255,255,.72);

  font-size:.95rem;
  line-height:1.65;
}

.origin-list {
  margin-top:20px;

  color:var(--white);

  font-size:.78rem;
  font-weight:900;
  line-height:1.7;

  text-transform:uppercase;
}

.shop-button {
  display:inline-flex;
  align-items:center;
  justify-content:center;

  align-self:flex-start;

  min-height:50px;

  margin-top:30px;
  padding:12px 22px;

  border-radius:999px;

  background:var(--teal);
  border:2px solid var(--teal);

  color:var(--white);

  font-size:.78rem;
  font-weight:900;
  letter-spacing:.07em;

  text-transform:uppercase;
}

.texture-category-card:hover .shop-button {
  background:var(--gold);
  border-color:var(--gold);
  color:var(--black);
}

/* =========================
   OTHER TEXTURES
========================= */

.other-textures {
  padding:80px 5%;
  background:var(--white);
}

.texture-buttons {
  width:min(1000px,100%);
  margin:35px auto 0;

  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));

  gap:15px;
}

.texture-choice {
  min-height:60px;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:14px;

  border:2px solid var(--gold);
  border-radius:14px;

  background:var(--black);
  color:var(--white);

  font-weight:900;

  text-align:center;
  text-transform:uppercase;

  transition:.2s ease;
}

.texture-choice:hover {
  background:var(--gold);
  color:var(--black);
}

.texture-choice.active {
  background:var(--teal);
  border-color:var(--teal);
  color:var(--white);
}

/* =========================
   FOOTER
========================= */

.footer {
  padding:58px 5% 25px;

  background:#050505;
  color:var(--white);

  border-top:2px solid var(--gold);
}

.footer-grid {
  width:min(1200px,100%);
  margin:auto;

  display:grid;
  grid-template-columns:1.3fr 1fr 1fr 1fr;

  gap:38px;
}

.footer h3,
.footer h4 {
  margin-bottom:14px;
  color:var(--gold);
}

.footer p,
.footer a {
  display:block;

  margin:8px 0;

  color:rgba(255,255,255,.69);

  font-size:.9rem;
}

.footer a:hover {
  color:var(--teal);
}

.copyright {
  width:min(1200px,100%);

  margin:38px auto 0;
  padding-top:22px;

  border-top:1px solid rgba(255,255,255,.11);

  color:rgba(255,255,255,.48);

  text-align:center;

  font-size:.78rem;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:900px) {

  .header-inner {
    flex-direction:column;
    padding:15px 0;
  }

  .nav {
    justify-content:center;
  }

  .texture-category-grid {
    grid-template-columns:1fr;
  }

  .footer-grid {
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

}

@media(max-width:650px) {

  .site-header {
    position:static;
  }

  .logo {
    width:160px;
  }

  .texture-hero {
    padding:65px 5%;
